NODE_ENV=development
TELEGRAM_MODE=temporary

# Telegram Bot API
TELEGRAM_BOT_TOKEN=

# Telegram MTProto user account (required only in live mode)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Personal chat destination for live mode
TELEGRAM_CHAT_ID=

# Comma-separated public usernames, e.g. @channel_one,@public_group
SOURCE_CHATS=@example_channel

# Optional email for MyMemory quota identification
MYMEMORY_EMAIL=

# Processing options
TRANSLATE_ONLY_ENGLISH=true
ENABLE_SOURCE_LINK=true
LOG_LEVEL=debug

DISABLE_SINGLE_INSTANCE=true